--- before/scripts/mutation-go-audit.py
+++ after/scripts/mutation-go-audit.py
@@ -0,0 +1,40 @@
+#!/usr/bin/env python3
+"""Record official Gremlins input diffs and test output; never modify source.
+
+Installed as `go` on a temporary PATH by test-mutations.sh. Replaces itself with
+real Go so Gremlins still controls the process, exit code and timeout directly.
+"""
+import difflib
+import json
+import os
+from pathlib import Path
+import sys
+import uuid
+
+real_go = os.environ["MUTATION_REAL_GO"]
+audit = Path(os.environ["MUTATION_AUDIT_DIR"])
+args = sys.argv[1:]
+if args and args[0] == "test":
+    args = ["test", "-count=1", *args[1:]]
+if len(sys.argv) > 1 and sys.argv[1] == "test":
+    baseline = json.loads((audit / "source.json").read_text())
+    changes = []
+    patches = []
+    for name, before in baseline.items():
+        source = Path.cwd() / name
+        if not source.is_file():
+            continue
+        after = source.read_text()
+        if before != after:
+            changes.append(name)
+            patches.extend(difflib.unified_diff(before.splitlines(True), after.splitlines(True), fromfile="original/" + name, tofile="mutant/" + name))
+    if changes:
+        run = audit / "executions" / uuid.uuid4().hex
+        run.mkdir(parents=True)
+        (run / "mutation.patch").write_text("".join(patches))
+        (run / "command.json").write_text(json.dumps({"cwd": str(Path.cwd()), "argv": [real_go, *args], "changed_files": changes}, indent=2) + "\n")
+        output = os.open(run / "test.log", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        os.dup2(output, 1)
+        os.dup2(output, 2)
+        os.close(output)
+os.execv(real_go, [real_go, *args])
