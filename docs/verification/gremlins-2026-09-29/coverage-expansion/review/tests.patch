+	for _, c := range []struct{ query, scan, iterate error }{{repoFailure, nil, nil}, {nil, repoFailure, nil}, {nil, nil, repoFailure}} {
+		d.err = c.query
+		d.rows = &testRows{err: c.iterate}
+		if c.scan != nil {
+			d.rows.records = []testRow{{err: c.scan}}
+		}
+		_, e = r.List(ctx, "w", "", 1)
+		requireError(t, e, repoFailure)
+		if c.query == nil && !d.rows.closed {
+			t.Fatal("rows leaked")
+		}
+	}
+	d.err = nil
+	bad := record("bad", 1)
+	bad.values[4] = "XXX"
+	d.rows = &testRows{records: []testRow{bad}}
+	_, e = r.List(ctx, "w", "", 1)
+	requireError(t, e, money.ErrInvalidCurrency)
+	bad = record("bad", 1)
