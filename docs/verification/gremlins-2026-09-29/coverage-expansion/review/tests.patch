+	requireArgs(t, d, "w", int64(0), 2)
+	d.rows = &testRows{records: []testRow{record("l2", 8)}}
+	next, e := r.List(ctx, "w", page.NextCursor, 200)
+	requireError(t, e, nil)
+	requireArgs(t, d, "w", int64(7), 201)
