+	d.row = testRow{values: []any{"BRL", "9223372036854775808", int64(2)}}
+	_, e = r.Totals(ctx, "w")
+	requireError(t, e, money.ErrOverflow)
+	d.row = testRow{values: []any{"XXX", "1", int64(2)}}
+	_, e = r.Totals(ctx, "w")
+	requireError(t, e, money.ErrInvalidCurrency)
