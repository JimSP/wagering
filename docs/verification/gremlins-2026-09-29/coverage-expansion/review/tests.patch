+	requireError(t, e, nil)
+	if len(page.Entries) != 1 || page.Entries[0].ID() != "l1" || page.Entries[0].BalanceAfter().Minor() != 100 || page.NextCursor != base64.RawURLEncoding.EncodeToString([]byte("w:7")) || !d.rows.closed {
+		t.Fatal(page)
