# --- App ---
ROLES=api,sqs-consumer,outbox-publisher,reference-worker
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=25s
# Janela global de admissão de BET/REFUND; duração positiva em segundos inteiros.
BET_WINDOW=5m
LOG_LEVEL=info

# Gere as credenciais com go run ./cmd/init-env (não copie este arquivo).
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
TEST_EXPIRED_CLIENT_SECRET=

# --- PostgreSQL ---
DATABASE_URL=

# --- AWS / MiniStack (SQS + IAM local, sem token de licença) ---
AWS_REGION=us-east-1
AWS_PROFILE=worker
AWS_SHARED_CREDENTIALS_FILE=./.local/aws-credentials
AWS_ENDPOINT_URL=http://localhost:4566
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# --- OIDC (Keycloak) ---
OIDC_ISSUER=http://localhost:8081/realms/wagering
OIDC_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api

# --- Clientes de teste (definidos em deploy/keycloak/realm-export.json) ---
TEST_PROVIDER_A_CLIENT_ID=provider-a
TEST_PROVIDER_A_CLIENT_SECRET=
TEST_PROVIDER_B_CLIENT_ID=provider-b
TEST_PROVIDER_B_CLIENT_SECRET=
TEST_INTERNAL_CLIENT_ID=internal-service
TEST_INTERNAL_CLIENT_SECRET=


SETTLEMENT_QUEUE_URL=http://localhost:4566/000000000000/wager-settlements.fifo

# Optional tracing; enable with OTEL_SDK_DISABLED=false and the observability profile.
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=wagering
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Parent-based sampling; probability for new root traces (0..1).
OTEL_TRACES_SAMPLER_ARG=1
# Dedicated per-process metrics listener; empty disables it outside Compose.
METRICS_ADDR=
